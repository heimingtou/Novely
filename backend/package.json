{
  "name": "novely-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express Backend Foundation for Novely",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "test:db": "node --test --test-concurrency=1 integration/*.test.js",
    "test:db:prisma": "node --test integration/prisma.test.js",
    "test:db:http": "node --test integration/express-database.test.js",
    "db:snapshot": "node scripts/snapshot-database.js",
    "db:introspect": "node scripts/prisma.js introspect",
    "db:validate": "node scripts/prisma.js validate",
    "db:generate": "node scripts/prisma.js generate",
    "db:format": "node scripts/prisma.js format",
    "db:transition:check": "node scripts/migrate-restore.js --check",
    "db:transition:apply": "node scripts/migrate-restore.js --apply",
    "db:transition:validate": "node scripts/prisma-transition.js validate",
    "db:transition:generate": "node scripts/prisma-transition.js generate",
    "test:transition": "node --test --test-concurrency=1 transition-tests/*.test.js",
    "test:permissions": "node --test transition-tests/permissions.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1"
  },
  "overrides": {
    "@prisma/config@7.10.1": {
      "effect": "3.22.5"
    }
  }
}
