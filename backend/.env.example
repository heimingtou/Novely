# Only this backend/.env file is loaded; the frontend .env is separate.
# An external file may be loaded with Node --env-file; existing process variables win.
NODE_ENV=development
PORT=4000
# Auth only: at least 32 characters. Use the SAME server-only value as Next.js
# when interoperating with its novely_session cookies. Never expose via NEXT_PUBLIC_.
# AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# Exact browser origins, separated by commas. Include port 3100 for local E2E.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# Example only. Replace CHANGE_ME locally; percent-encode special password characters.
# Default: accepted 19-table Local baseline. No production connection is implicit.
DATABASE_PROFILE=local
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5432/novely_reconcile_test?schema=public"

# Local 21-table restore: DATABASE_PROFILE=local-transition, database novely_restore_test.
# Supabase Foundation runtime (use a separate ignored/external env file):
# DATABASE_PROFILE=supabase
# DATABASE_URL="postgresql://novely_backend.PROJECT_REF:URL_ENCODED_PASSWORD@APPROVED_SESSION_POOLER:5432/postgres?schema=public"
# SUPABASE_PROJECT_REF=PROJECT_REF
# SUPABASE_DB_HOST=APPROVED_SESSION_POOLER
# SUPABASE_DB_ROLE=novely_backend
# DATABASE_CA_FILE=D:/prod-ca-2021.crt
# Host/port must be verified in Dashboard. Direct db.PROJECT_REF.supabase.co is also supported.
# Do not put sslmode/sslrootcert/options in the URL: pg receives strict TLS options directly.
# API publishable/secret keys do not authenticate a PostgreSQL runtime connection.
# The Supabase profile is read-only for Foundation; no production DML/Forum grants.

